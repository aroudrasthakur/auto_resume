# Backend API base URL (no trailing slash). Required.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Optional: set to "true" to bypass Cognito and use dev login (local only).
# NEXT_PUBLIC_DEV_AUTH_BYPASS=true

# Cognito (required when NEXT_PUBLIC_DEV_AUTH_BYPASS is not set)
# NEXT_PUBLIC_COGNITO_DOMAIN=your-user-pool-domain.auth.region.amazoncognito.com
# NEXT_PUBLIC_COGNITO_CLIENT_ID=your-app-client-id
# NEXT_PUBLIC_REDIRECT_URI=http://localhost:3000/auth/callback
