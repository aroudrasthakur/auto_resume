\documentclass{resume}

% Personal Information
\name{{ "{" ~ name ~ "}" }}
{% if email %}\email{{ "{" ~ email ~ "}" }}{% endif %}
{% if phone %}\phone{{ "{" ~ phone ~ "}" }}{% endif %}
{% if location %}\location{{ "{" ~ location ~ "}" }}{% endif %}
{% if linkedin %}\linkedin{{ "{" ~ linkedin ~ "}" }}{% endif %}
{% if github %}\github{{ "{" ~ github ~ "}" }}{% endif %}
{% if website %}\website{{ "{" ~ website ~ "}" }}{% endif %}

\begin{document}

% Header
\resumeHeader

%-------------------------------------------------------------------------------
%	EDUCATION SECTION
%-------------------------------------------------------------------------------
{% if education %}
\section{Education}
\resumeItemListStart
{% for edu in education %}
\resumeSubheading{{ "{" ~ edu.school ~ (", " ~ edu.location if edu.location else "") ~ "}" }}{{ "{" ~ edu.start_date ~ (" -- " ~ edu.end_date if edu.end_date else "") ~ "}" }}{{ "{" ~ (edu.degree ~ (", " ~ edu.major if edu.major else "") if edu.degree else "") ~ "}" }}{{ "{" ~ ("GPA: " ~ edu.gpa if edu.gpa else "") ~ "}" }}
{% if edu.highlights %}
{% for highlight in edu.highlights %}
\resumeItem{{ "{" ~ highlight ~ "}" }}
{% endfor %}
{% endif %}
{% endfor %}
\resumeItemListEnd
{% endif %}

%-------------------------------------------------------------------------------
%	EXPERIENCE SECTION
%-------------------------------------------------------------------------------
{% if experience %}
\section{Experience}
\resumeItemListStart
{% for exp in experience %}
\resumeSubheading{{ "{" ~ exp.company ~ (", " ~ exp.location if exp.location else "") ~ "}" }}{{ "{" ~ exp.start_date ~ (" -- " ~ (exp.end_date if exp.end_date else "Present") if (exp.end_date or exp.is_current) else "") ~ "}" }}{{ "{" ~ (exp.role or "") ~ "}" }}{{ "{}" }}
{% if exp.bullets %}
{% for bullet in exp.bullets %}
\resumeItem{{ "{" ~ bullet.bullet ~ "}" }}
{% endfor %}
{% endif %}
{% endfor %}
\resumeItemListEnd
{% endif %}

%-------------------------------------------------------------------------------
%	PROJECTS SECTION
%-------------------------------------------------------------------------------
{% if projects and include_projects %}
\section{Projects}
\resumeItemListStart
{% for proj in projects %}
\resumeProjectHeading{{ "{" ~ proj.name ~ "}" }}{{ "{" ~ proj.start_date ~ (" -- " ~ proj.end_date if proj.end_date else "") ~ "}" }}{{ "{" ~ (proj.role or "") ~ "}" }}{{ "{}" }}
{% if proj.bullets %}
{% for bullet in proj.bullets %}
\resumeItem{{ "{" ~ bullet.bullet ~ "}" }}
{% endfor %}
{% endif %}
{% if proj.technologies %}
\resumeItem{\textbf{Technologies:} {{ proj.technologies | join(', ') }}}
{% endif %}
{% endfor %}
\resumeItemListEnd
{% endif %}

%-------------------------------------------------------------------------------
%	SKILLS SECTION
%-------------------------------------------------------------------------------
{% if skills and include_skills %}
\section{Technical Skills}
\resumeItemListStart
{% for category in skills.categories %}
\resumeSubItem{{ "{" ~ category.name ~ "}" }}{{ "{" ~ ((category.get('items') or []) | join(', ')) ~ "}" }}
{% endfor %}
\resumeItemListEnd
{% endif %}

\end{document}

