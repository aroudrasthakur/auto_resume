# Supabase Configuration
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=
DATABASE_URL=

# Auth Configuration
# If using Cognito, fill these. If using DEV_AUTH_BYPASS="true", these can be left blank.
# COGNITO_CLIENT_SECRET is required when your Cognito app client has a secret.
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
COGNITO_CLIENT_SECRET=
COGNITO_REGION=
COGNITO_JWKS_URL=
DEV_AUTH_BYPASS=

# AI Provider Configuration
# Allowed: "mock", "openai", "ollama"
AI_PROVIDER=
OPENAI_API_KEY=
# Optional: OPENAI_MODEL (default gpt-4o-mini). Use gpt-4o for higher quality.
OLLAMA_URL=

# Embedding Model Configuration
# If you use pgvector embeddings later
EMBEDDING_PROVIDER=
EMBEDDING_MODEL=
EMBEDDING_DIMENSION=

# Redis Configuration
REDIS_URL=

# Encryption Key (32 bytes hex, 64 hex chars)
ENCRYPTION_KEY=

# Backend Configuration
API_HOST=
API_PORT=
ENVIRONMENT=

# Worker Configuration
CELERY_CONCURRENCY=

# Frontend Configuration
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_COGNITO_DOMAIN=
NEXT_PUBLIC_COGNITO_CLIENT_ID=
NEXT_PUBLIC_REDIRECT_URI=
